# Production Environment Configuration for Railway Deployment

# Database Configuration
# DATABASE_URL is set in Railway environment variables

# Security
# SECRET_KEY is set in Railway environment variables

# CORS Origins - Allow Vercel frontend
BACKEND_CORS_ORIGINS=https://rangila-qwpm.vercel.app,https://rangila.vercel.app,https://*.vercel.app

# Razorpay Configuration
# RAZORPAY_KEY_ID is set in Railway environment variables
# RAZORPAY_KEY_SECRET is set in Railway environment variables
